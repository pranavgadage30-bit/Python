def dynamicArray(n, queries):
    arr = [[] for _ in range(n)]
    lastAnswer = 0
    result = []

    for q in queries:
        t, x, y = q

        index = (x ^ lastAnswer) % n

        if t == 1:
            arr[index].append(y)

        else:
            lastAnswer = arr[index][y % len(arr[index])]
            result.append(lastAnswer)

    return result

